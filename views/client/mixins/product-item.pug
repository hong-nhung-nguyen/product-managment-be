mixin product-item(item)
    .col-md-3
        .product-card.rounded.shadow-sm
            a.product-card-image(href=`/products/detail/${item.slug}`)
                img(src=item.thumbnail alt=item.title class="img-fluid")
                if item.featured == "1"
                    .product-badge Featured
            .product-card-body.p-3
                h3.product-title
                    a(href=`/products/detail/${item.slug}`) #{item.title}
                .product-price.d-flex.align-items-center.gap-2
                    span.price-new #{item.priceNew}$
                    if item.price
                        span.price-old #{item.price}$
                if item.discountPercentage
                    span.product-discount.text-danger -#{item.discountPercentage}%
