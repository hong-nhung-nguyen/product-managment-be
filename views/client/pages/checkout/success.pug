extends ../../layouts/default.pug 
include ../../mixins/box-head.pug 

block main 
    .container.my-3 
        .row 
            .col-12 
                +box-head("Order Success")
        
        .row    
            .col-12 
                div(class="alert alert-success")
                    | Order placed successfully! We will process the order 
                    | as soon as possible.
        
        if(order)
            .row   
                .col-12 
                    h4(class="mb-2") Personal Information 
                    table(class="table table-bordered")
                        tbody 
                            tr 
                                td Full Name 
                                td 
                                    b #{order.userInfo.fullName}
                            tr 
                                td Phone Number  
                                td 
                                    b #{order.userInfo.phone}
                            tr 
                                td Address 
                                td 
                                    b #{order.userInfo.address}
            
            .row 
                .col-12 
                    h4(class="mb-2") Order Information 
                    table(class="table table-bordered")
                        thead
                            tr 
                                th STT 
                                th Image 
                                th Name 
                                th Price
                                th Quantity 
                                th Total 
                            
                        tbody
                            each item, index in order.products 
                                tr 
                                    td #{index + 1} 
                                    td 
                                        img(src=item.productInfo.thumbnail width="80px" alt=item.productInfo.slug)
                                    td #{item.productInfo.title} 
                                    td $#{item.priceNew} 
                                    td #{item.quantity} 
                                    td $#{item.totalPrice} 
            
            if(order.products.length > 0)
                h3(class="text-end") Order Total: $#{order.totalPrice}