mixin form-change-multi(action, page)
    form(
        action= action
        method="POST"
        form-change-multi
    )
        //- Hidden input = the only way for the form to send extra data without user input
        input(type="hidden" name="page" value=page)
        .d-flex.align-items-start 
            .form-group 
                select(name="type" class="form-control")
                    option(disabled selected) -- Action --
                    if(role.permissions.includes("products_edit"))
                        option(value="active") Active
                        option(value="inactive") Inactive
                    if(role.permissions.includes("products_delete"))
                        option(value="delete-all") Delete All
                    if(role.permissions.includes("products_edit"))
                        option(value="change-position") Change Position
            .form-group 
                input(
                    type="text"
                    name="ids"
                    value=""
                    class="form-control d-none"
                )
                //- at first display this input so it is easier to understand
                //- after front-end handling is finished, it can be hidden
            button(type="submit" class="btn btn-primary") Apply