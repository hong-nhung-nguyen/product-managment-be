extends ../../layouts/default.pug 
include ../../mixins/select-tree.pug
include ../../mixins/alert.pug

block main 
    +alert-error("5000")
    +alert-success("5000")

    h1(class="mb-4") Edit Product Category

    form(
        action=`${prefixAdmin}/products-category/edit/${record.id}?_method=PATCH`
        method="POST"
        enctype="multipart/form-data"
    )
        div(class="form-group")
            label(for="title") Title
            input(
                type="text"
                class="form-control"
                id="title"
                name="title"
                value=record.title
            )
        div(class="form-group")
            label(for="parent_id") Parent Category
            //- input(
            //-     type="text"
            //-     class="form-control"
            //-     id="parent_id"
            //-     name="parent_id"
            //- )
            select(
                name="parent_id"
                id="parent_id"
                class="form-control"
            )
                option(value="") -- Select parent category --
                if(records)
                    +select-tree(records, record.parent_id)
        div(class="form-group")
            label(for="desc") Description
            textarea(
                class="form-control textarea-mce"
                id="desc"
                name="description"
                rows="5"
            ) #{record.description}
        //- do not name an element by ids for resuable reason in future
        div(
            class="form-group"
            upload-image
        )
            label(for="thumbnail") Image 
            input(
                type="file"
                class="form-control-file image-input"
                id="thumbnail"
                name="thumbnail"
                accept="image/*"
                upload-image-input
            )
            img(
                src=record.thumbnail
                upload-image-preview
                class="image-preview"
            )
            span(
                remove-image-preview
                class="remove-image-button"
            ) x
        //- * = all image files
        div(class="form-group")
            label(for="position") Position
            input(
                type="number"
                class="form-control"
                id="position"
                name="position"
                placeholder="Auto increment"
                min="1"
                value=record.position
            )
        div(class="form-group form-check form-check-inline")
            input(
                type="radio"
                class="form-check-input"
                id="statusActive"
                name="status"
                value="active"
                checked= record.status == "active" ? true : false
            )
            label(for="statusActive" class="form-check-label") Active
        div(class="form-group form-check form-check-inline")
            input(
                type="radio"
                class="form-check-input"
                id="statusInActive"
                name="status"
                value="inactive"
                checked= record.status == "inactive" ? true: false
            )
            label(for="statusInActive" class="form-check-label") Inactive
        div(class="form-group")
            button(
                type="submit"
                class="btn btn-primary"
                ) Update
    