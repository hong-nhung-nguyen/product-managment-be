extends ../../layouts/default.pug 
include ../../mixins/alert.pug 

block main 
    if(role.permissions.includes("accounts_create"))
        h1(class="mb-4") Create Account 

        +alert-success(5000)
        +alert-error(5000)

        form(
            action=`${prefixAdmin}/accounts/create`
            method="POST"
            enctype="multipart/form-data"
        )
            div(class="form-group mb-3")
                label(for="fullName") Full Name *
                input(
                    type="text"
                    class="form-control"
                    id="fullName"
                    name="fullName"
                )
            div(class="form-group mb-3")
                label(for="email") Email * 
                input(
                    type="email"
                    class="form-control"
                    id="email"
                    name="email"
                )
            div(class="form-group mb-3")
                label(for="password") Password * 
                input(
                    type="password"
                    class="form-control"
                    id="password"
                    name="password"
                )
            div(class="form-group mb-3")
                label(for="phone") Phone Number
                input(
                    type="text"
                    class="form-control"
                    id="phone"
                    name="phone"
                )
            div(
                class="form-group mb-3"
                upload-image
            )
                label(for="avatar") Profile Picture 
                input(
                    type="file"
                    class="form-control-file w-100"
                    id="avatar"
                    name="avatar"
                    accept="image/*"
                    upload-image-input
                )
                img(
                    src=""
                    class="image-preview"
                    upload-image-preview
                )
            div(class="form-group mb-3")
                label(for="role_id") Role 
                select(name="role_id" id="role_id" class="form-control")
                    option(disabled selected) -- Select Role --
                    each role in roles 
                        option(value=role.id) #{role.title} 
            div(class="form-group form-check form-check-inline") 
                input(
                    type="radio"
                    class="form-check-input" 
                    id="statusActive" 
                    name="status" 
                    value="active" 
                    checked
                )
                label(for="statusActive" class="form-check-label") Active
            div(class="form-group form-check form-check-inline") 
                input(
                    type="radio"
                    class="form-check-input" 
                    id="statusInactive" 
                    name="status" 
                    value="inactive" 
                )
                label(for="statusInactive" class="form-check-label") Inactive
            
            div(class="form-group mt-3")
                button(
                    type="submit"
                    class="btn btn-primary"
                ) Create