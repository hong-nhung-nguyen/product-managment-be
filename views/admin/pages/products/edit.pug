extends ../../layouts/default.pug 
include ../../mixins/alert.pug


block main  
    if(role.permissions.includes("products_edit"))
        +alert-error("5000")
        +alert-success(5000)

        h1(class="mb-4") Edit Product

        form(
            action=`${prefixAdmin}/products/edit/${product._id}?_method=PATCH`
            id="form-edit-product"
            method="POST"
            enctype="multipart/form-data"
        )
            div(class="form-group")
                label(for="title") Title
                input(
                    type="text"
                    class="form-control"
                    id="title"
                    name="title"
                    value=product.title
                )
            div(class="form-group")
                label(for="desc") Description
                textarea(
                    class="form-control"
                    id="desc"
                    name="description"
                    rows="5"
                ) #{product.description}
            div(class="form-group")
                label(for="price") Price
                input(
                    type="number"
                    class="form-control"
                    id="price"
                    name="price"
                    value=product.price
                )
            div(class="form-group")
                label(for="discount") Discount %
                input(
                    type="number"
                    class="form-control"
                    id="discount"
                    name="discountPercentage"
                    value=product.discountPercentage
                )
            div(class="form-group")
                label(for="stock") Stock
                input(
                    type="number"
                    class="form-control"
                    id="stock"
                    name="stock"
                    value=product.stock
                )
            //- do not name an element by ids for resuable reason in future
            div(
                class="form-group"
                upload-image
            )
                label(for="thumbnail") Thumbnail
                input(
                    type="file"
                    class="form-control-file image-input"
                    id="thumbnail"
                    name="thumbnail"
                    accept="image/*"
                    upload-image-input
                )
                img(
                    src=product.thumbnail
                    upload-image-preview
                    class="image-preview"
                )
                span(
                    remove-image-preview
                    class="remove-image-button d-none"
                ) x
            //- * = all image files
            div(class="form-group")
                label(for="position") Position
                input(
                    type="number"
                    class="form-control"
                    id="position"
                    name="position"
                    placeholder="Auto-increment"
                    value=product.position
                )
            div(class="form-group form-check form-check-inline")
                input(
                    type="radio"
                    class="form-check-input"
                    id="statusActive"
                    name="status"
                    value="active"
                    checked= product.status == "active" : true ? false
                )
                label(for="statusActive" class="form-check-label") Active
            div(class="form-group form-check form-check-inline")
                input(
                    type="radio"
                    class="form-check-input"
                    id="statusInActive"
                    name="status"
                    value="inactive"
                    checked = product.status == "inactive" : true ? false
                )
                label(for="statusInActive" class="form-check-label") Inactive
            div(class="form-group")
                button(
                    type="submit"
                    class="btn btn-primary"
                ) Update


        script(src="/admin/js/product.js")