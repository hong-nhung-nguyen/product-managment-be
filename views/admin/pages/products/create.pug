extends ../../layouts/default.pug 
include ../../mixins/alert.pug
include ../../mixins/select-tree.pug


block main  
    if (role.permissions.includes("products_create"))
        +alert-error("5000")

        h1(class="mb-4") Create Product

        form(
            action=`${prefixAdmin}/products/create`
            id="form-create-product"
            method="POST"
            enctype="multipart/form-data"
        )
            div(class="form-group")
                label(for="title") Title
                input(
                    type="text"
                    class="form-control"
                    id="title"
                    name="title"
                )
            div(class="form-group")
                label(for="product_category_id")
                select(
                    name="product_category_id"
                    id="product_category_id"
                    class="form-control"
                )
                    option(value="") -- Select Product Category --
                    if(records)
                        +select-tree(records)
            div(class="form-group")
                label(for="desc") Description
                textarea(
                    class="form-control textarea-mce"
                    id="desc"
                    name="description"
                    rows="5"
                )
            div(class="form-group")
                label(for="price") Price
                input(
                    type="number"
                    class="form-control"
                    id="price"
                    name="price"
                    value="0"
                    min="0"
                )
            div(class="form-group")
                label(for="discount") Discount %
                input(
                    type="number"
                    class="form-control"
                    id="discount"
                    name="discountPercentage"
                    value="0"
                    min="0"
                )
            div(class="form-group")
                label(for="stock") Stock
                input(
                    type="number"
                    class="form-control"
                    id="stock"
                    name="stock"
                    value="0"
                    min="0"
                )
            //- do not name an element by ids for resuable reason in future
            div(
                class="form-group"
                upload-image
            )
                label(for="thumbnail") Thumbnail
                input(
                    type="file"
                    class="form-control-file image-input"
                    id="thumbnail"
                    name="thumbnail"
                    accept="image/*"
                    upload-image-input
                )
                img(
                    src=''
                    upload-image-preview
                    class="image-preview"
                )
                span(
                    remove-image-preview
                    class="remove-image-button"
                ) x
            //- * = all image files
            div(class="form-group")
                label(for="position") Position
                input(
                    type="number"
                    class="form-control"
                    id="position"
                    name="position"
                    placeholder="Auto-increment"
                    min="1"
                )
            div(class="form-group")
                label(class="d-block mb-2") Featured
                div(class="form-group form-check form-check-inline")
                    input(
                        type="radio"
                        class="form-check-input"
                        id="featuredTrue"
                        name="featured"
                        value="1"
                        checked
                    )
                    label(for="featuredTrue" class="form-check-label") Yes
                div(class="form-group form-check form-check-inline")
                    input(
                        type="radio"
                        class="form-check-input"
                        id="featuredFalse"
                        name="featured"
                        value="0"
                    )
                    label(for="featuredFalse" class="form-check-label") No
            div(class="form-group")
                label(class="d-block mb-2") Status
                div(class="form-group form-check form-check-inline")
                    input(
                        type="radio"
                        class="form-check-input"
                        id="statusActive"
                        name="status"
                        value="active"
                        checked
                    )
                    label(for="statusActive" class="form-check-label") Active
                div(class="form-group form-check form-check-inline")
                    input(
                        type="radio"
                        class="form-check-input"
                        id="statusInActive"
                        name="status"
                        value="inactive"
                    )
                    label(for="statusInActive" class="form-check-label") Inactive
            div(class="form-group")
                button(
                    type="submit"
                    class="btn btn-primary"
                ) Create New


        script(src="/admin/js/product.js")