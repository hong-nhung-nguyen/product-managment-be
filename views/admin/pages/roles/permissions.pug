extends ../../layouts/default.pug 
include ../../mixins/alert.pug

block main 
    h1(class="mb-4") Permissions

    +alert-success(5000)
    +alert-error(5000)

    //- div #{records}

    if(records)
        div(data-records=records)

        div(class="text-end")
            button(
                type="submit"
                class="btn btn-primary mb-3"
                button-submit
            ) Update 
        
        table(
            class="table table-hover table-sm"
            table-permissions
        )
            thead 
                tr 
                    th Feature 
                    each record in records 
                        th(class="text-center") #{record.title}
            tbody 
                tr(data-name="id")
                    td(class="d-none")
                    each record in records 
                        td(class="text-center d-none")
                            input(type="text" value=record.id)
                tr 
                    td(colspan="4")
                        b Product Categories
                tr(data-name="products-category_view")
                    td View 
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                tr(data-name="products-category_create")
                    td Add
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                tr(data-name="products-category_edit")
                    td Edit
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                tr(data-name="products-category_delete")
                    td Delete
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                

                tr 
                    td(colspan="4")
                        b Products 
                tr(data-name="products_view")
                    td View 
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                tr(data-name="products_create")
                    td Add
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                tr(data-name="products_edit")
                    td Edit
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                tr(data-name="products_delete")
                    td Delete
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                

                tr 
                    td(colspan="4")
                        b Role Groups
                tr(data-name="roles_view")
                    td View 
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                tr(data-name="roles_create")
                    td Add
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                tr(data-name="roles_edit")
                    td Edit
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                tr(data-name="roles_delete")
                    td Delete
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                

                tr 
                    td(colspan="4")
                        b Permissions
                tr(data-name="permissions_view")
                    td View 
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                tr(data-name="permissions_edit")
                    td Edit
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                

                tr 
                    td(colspan="4")
                        b Accounts
                tr(data-name="accounts_view")
                    td View 
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                tr(data-name="accounts_create")
                    td Add
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                tr(data-name="accounts_edit")
                    td Edit
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                tr(data-name="accounts_delete")
                    td Delete
                    each record, index in records 
                        td(class="text-center")
                            input(type="checkbox")
                
    
    
    form(
        id="form-change-permissions"
        method="POST"
        action=`${prefixAdmin}/roles/permissions?_method=PATCH`
        class="d-none"
    )
        div(class="form-group")
            input(
                type="text"
                class="form-control"
                name="permissions"
            )
    
    script(src="/admin/js/role.js") 